{
  "expo": {
    "name": "stayt-app",
    "slug": "stayt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nitridee.staytapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#56C007",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nitridee.staytapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "samridha",
    "plugins": [
      "./modules/blocker/plugin",
      "expo-font",
      "expo-splash-screen",
      "expo-iap",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "52bc0820-3bfb-4449-916e-d600b46a3dd0"
      }
    }
  }
}
