<?xml version="1.0" encoding="utf-8"?>
<!-- P2-1 home-screen widget layout (FREE). Mini dashboard, filled from
     WidgetData by StayTWidgetProvider: mascot + status header, big focus
     total, active-task line, streak / guarded-apps footer. Card background
     and mascot variant are swapped at update time for day/night (RemoteViews
     only allows framework views — LinearLayout/TextView/ImageView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/stayt_owl_blocked"
            android:contentDescription="StayT owl" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STAYT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#58CC02" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY TO FOCUS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/widget_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ROUGH DAY — OWL BELIEVES IN REBOUNDS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#58CC02"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="NOW: DEEP WORK"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#58CC02"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_focus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0m"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FOCUS TODAY"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#8A8A8A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NO STREAK YET"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/widget_guarded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO APPS GUARDED"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8A8A8A" />
    </LinearLayout>
</LinearLayout>
