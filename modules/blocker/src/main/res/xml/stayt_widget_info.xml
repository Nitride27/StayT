<?xml version="1.0" encoding="utf-8"?>
<!-- P2-1 widget provider info. Dashboard-sized default (roughly 3x2 cells),
     resizable both ways. updatePeriodMillis stays 0: JS pushes updates
     (session start/end) and the midnight receiver rolls the day over. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/stayt_widget"
    android:description="@string/stayt_widget_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
