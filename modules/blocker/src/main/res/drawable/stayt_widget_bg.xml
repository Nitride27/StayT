<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card background (night): Duolingo-midnight rounded card. Swapped
     in at update time via setBackgroundResource (RemoteViews-safe). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#000437" />
    <corners android:radius="24dp" />
    <stroke
        android:width="2dp"
        android:color="#58CC02" />
</shape>
