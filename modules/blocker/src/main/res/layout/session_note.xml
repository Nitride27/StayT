<?xml version="1.0" encoding="utf-8"?>
<!-- Session note (ADR-0007/0008), clean + minimal: app icon, task + status,
     native Chronometer (condensed bold, echoing the in-app Anton timer), play/pause. Card
     background + text colors follow the app theme at runtime (black /
     white); values here are the dark defaults. RemoteViews: framework
     views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/session_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/session_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="StayT"
        android:src="@mipmap/ic_launcher_round" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textStyle="bold"
            android:singleLine="true"
            android:text="Focus"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/session_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Focusing"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/session_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <ImageButton
        android:id="@+id/session_toggle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/session_toggle_bg"
        android:contentDescription="Pause session"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_note_pause" />
</LinearLayout>
